# MediSync Environment Configuration
# Copy this file to .env and customize for your deployment

# ===========================================
# Core Database
# ===========================================
DATABASE_URL=postgresql://medisync:medisync_dev@localhost:5432/medisync
POSTGRES_PASSWORD=medisync_dev

# ===========================================
# Session & Security
# ===========================================
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-random-64-char-string
COOKIE_SECURE=false
# Set to true in production with HTTPS
# COOKIE_SECURE=true

# ===========================================
# API Configuration
# ===========================================
CORS_ORIGIN=http://localhost:3000
API_PORT=3001
NODE_ENV=development

# ===========================================
# S3 / MinIO Object Storage
# ===========================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=medisync
S3_SECRET_KEY=medisync_dev
S3_BUCKET=medisync
S3_REGION=us-east-1

# ===========================================
# Email / Notifications (configure for production)
# ===========================================
# SMTP settings for email notifications
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@medisync.local

# Push notification provider (FCM, APNS, etc.)
# PUSH_PROVIDER=fcm
# FCM_SERVER_KEY=your-fcm-server-key

# SMS provider (Twilio, MSG91, etc.)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_FROM_NUMBER=+15551234567

# ===========================================
# Production Deployment
# ===========================================
# Domain for production (used by Traefik/Caddy)
# DOMAIN=medisync.example.com
# Let's Encrypt email for SSL certificates
# LETSENCRYPT_EMAIL=admin@example.com

# pgAdmin (development tools)
# PGADMIN_EMAIL=admin@medisync.local
# PGADMIN_PASSWORD=admin

# ===========================================
# Org/Multi-tenancy Settings
# ===========================================
# Default org type for new registrations (hospital|org|solo)
# DEFAULT_ORG_TYPE=solo
# Require legal document verification for incapacity requests
# REQUIRE_LEGAL_DOC_VERIFICATION=true

# ===========================================
# Backup Configuration
# ===========================================
# BACKUP_SCHEDULE=@daily
# BACKUP_KEEP_DAYS=30